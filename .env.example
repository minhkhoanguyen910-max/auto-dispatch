# Postgres (one server, two databases: POSTGRES_DB for the app, "traccar" for Traccar)
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dispatch

# Shared secret Traccar sends when forwarding positions to the API
TRACCAR_FORWARD_TOKEN=change-me

# Traccar admin login (created on first setup)
TRACCAR_ADMIN_EMAIL=admin@example.com
TRACCAR_ADMIN_PASSWORD=change-me

# Server URL drivers type into the Traccar Client app
TRACCAR_CLIENT_URL=http://your-server-ip:5055
# How often Traccar Client reports (set through the drivers' set-up QR code): every N seconds or N meters moved,
# and accuracy (highest / high / low)
TRACCAR_INTERVAL_SECONDS=30
TRACCAR_DISTANCE_METERS=30
TRACCAR_ACCURACY=high

# Road and walking maps (osrm and osrm-foot services): OpenStreetMap areas from download.geofabrik.de,
# comma-separated, that cover where drivers go. Changing it downloads and prepares the map again on the next start.
OSRM_REGIONS=europe/united-kingdom/england/east-sussex,europe/united-kingdom/england/kent,europe/united-kingdom/england/essex,europe/united-kingdom/england/greater-london

# Driver-facing Telegram bot from @BotFather. Leave empty to keep the bot disabled.
TELEGRAM_BOT_TOKEN=

# Google Maps Platform key (Geocoding API + Routes API)
GOOGLE_MAPS_API_KEY=

# Live driver map and address suggestions: a second Google key for browsers, restricted to the web app's address
# (HTTP referrer) and to the Maps JavaScript API + Places API (New), and a Map ID
# (Google Maps Platform > Map Management, JavaScript, Vector)
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
# Addresses are looked up and suggested only in this country, so a typo can't land abroad
ADDRESS_COUNTRY=GB
# Delivery area "lat,lng,km": addresses are looked up there first and never land outside it; places can be
# found by name ("Railway pub"). Empty = the whole country. Hastings and St Leonards:
ADDRESS_AREA=50.868,0.578,6
# Suggestions only in these towns (Google's area limit leaks: Battle, Bexhill). Empty = any town in the area
ADDRESS_TOWNS=Hastings,St Leonards

# Country code for customer phone numbers written without one (44 = UK)
PHONE_COUNTRY_CODE=44

# Driving times for route planning (Google Routes API, Route Matrix).
# next-leg = live traffic only for the next leg (cheaper); all = always; none = never
ROUTES_TRAFFIC=next-leg
# Most Route Matrix pairs requested from Google per day; after that, estimates are used
ROUTES_DAILY_LIMIT=5000
# Average town driving speed for estimates (no key, Google failing, or the daily limit reached)
FALLBACK_SPEED_KMH=25
# Ask Google only about each place's this many nearest stops; farther trips are estimated
ROUTES_NEAREST=8

# Route planning: the system sets each driver's stop sequence and ETAs. off = today's nearest-first list
ROUTE_OPTIMIZATION=false
# Minutes at each stop until there's enough history to learn it
SERVICE_MINUTES=5
# A driver's stop sequence only changes when the new one saves at least this many minutes
REROUTE_THRESHOLD_MINUTES=3
# "On the way": a new stop goes first if the detour / the current customer's delay stay within these (0 = off)
ON_THE_WAY_MAX_DETOUR_MINUTES=3
ON_THE_WAY_MAX_DELAY_MINUTES=8
# Overloaded (not every deadline can be kept): each late customer counts as this many minutes late, so as many as
# possible are on time and a few wait longer (rule B). 0 = only minutes late count, the delay is shared (rule A)
LATE_CUSTOMER_PENALTY_MINUTES=60
# "Deliver by 14:00" means 14:00 today here
APP_TIMEZONE=Europe/London
# Longest a customer should wait: new orders get "deliver by" = placed + this many minutes unless one is chosen (0 = off)
MAX_WAIT_MINUTES=60

# Meeting points: "parked" = only "I'm parked here, ask the customer to come out" after Arrived;
# "all" = also "Meet the customer instead" on upcoming stops
MEETING_POINTS=parked

# Signs web login cookies. Long random string; changing it logs everyone out.
SECRET_KEY=change-me
# Set to true once the web app is served over HTTPS
COOKIE_SECURE=false

# Only when running without Docker (docker compose sets these itself).
# scripts\setup.ps1 adds them from the POSTGRES_* values above.
# DATABASE_URL=postgresql+asyncpg://dispatch:change-me@localhost:5432/dispatch
# TRACCAR_URL=http://localhost:8082
